# E-mail da service account (Google Cloud → IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com

# Chave privada da service account (campo "private_key" do JSON baixado).
# Mantenha as aspas e os \n — o código converte para quebras de linha reais.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ID da planilha (o trecho entre /d/ e /edit na URL da planilha)
GOOGLE_SHEET_ID=1AbC...xyz

# Dias sem touch para considerar uma parceria "em risco" (default 30)
RISK_DAYS_THRESHOLD=30
